#------------------------------------------------------------------------------
# File:         gpx.fmt
# Description:  Vantrue E1 GPX format with Speed Extensions
#------------------------------------------------------------------------------
#[HEAD]<?xml version="1.0" encoding="utf-8"?>
#[HEAD]<gpx version="1.1" creator="ExifTool" xmlns="http://www.topografix.com/GPX/1/1" xmlns:gpxtpx="http://www.garmin.com/xmlschemas/TrackPointExtension/v1">
#[HEAD]<trk><name>$filename</name><trkseg>
#[BODY]<trkpt lat="$gpslatitude#" lon="$gpslongitude#"><time>$gpsdatetime</time><extensions><gpxtpx:TrackPointExtension><gpxtpx:speed>$gpsspeed#</gpxtpx:speed></gpxtpx:TrackPointExtension></extensions></trkpt>
#[TAIL]</trkseg></trk></gpx>